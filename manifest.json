{
  "manifest_version": "0.2",
  "name": "kicad-mcp",
  "version": "0.1.0",
  "description": "MCP server for KiCad electronic design automation (EDA) files",
  "author": {
    "name": "fsbondtec"
  },
  "server": {
    "type": "python",
    "entry_point": "kicad_mcp.server:main",
    "mcp_config": {
      "command": "uv",
      "args": [
        "--directory",
        "${__dirname}",
        "run",
        "kicad-mcp"
      ]
    }
  },
  "keywords": [
    "kicad",
    "eda",
    "electronics",
    "schematic",
    "pcb",
    "mcp"
  ],
  "license": "MIT"
}